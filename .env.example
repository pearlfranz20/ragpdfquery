# Copy to .env and fill in the credentials for your selected providers.

# Database (matches the local Postgres service in docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Providers: openai or bedrock
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# OpenAI (required when either provider above is openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072

# AWS Bedrock (used when either provider above is bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIM=1024

# OCR
USE_TEXTRACT=false
TEXTRACT_S3_BUCKET=

# Ingestion
CHUNKING_STRATEGY=recursive
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
INGEST_MAX_WORKERS=8
MAX_UPLOAD_SIZE_BYTES=52428800

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SIMILARITY=0.25

# Hallucination checking and evaluation
ENABLE_INLINE_FAITHFULNESS_CHECK=true
FAITHFULNESS_THRESHOLD=0.6
DEEPEVAL_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=INFO
